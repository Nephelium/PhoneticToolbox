{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis_config_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Analysis Config Hash",
      "type": "string"
    },
    "backend": {
      "minLength": 1,
      "title": "Backend",
      "type": "string"
    },
    "parameter_key": {
      "minLength": 1,
      "title": "Parameter Key",
      "type": "string"
    },
    "reason": {
      "items": {
        "anyOf": [
          {
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Reason",
      "type": "array"
    },
    "source_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Ids",
      "type": "array"
    },
    "times_s": {
      "items": {
        "minimum": 0,
        "type": "number"
      },
      "title": "Times S",
      "type": "array"
    },
    "unit": {
      "description": "Explicit scientific unit, e.g. Hz, dB, s, %, or 1; parameter mapping is audited in P03.",
      "minLength": 1,
      "title": "Unit",
      "type": "string"
    },
    "validity": {
      "items": {
        "enum": [
          "valid",
          "unvoiced",
          "missing",
          "failed"
        ],
        "type": "string"
      },
      "title": "Validity",
      "type": "array"
    },
    "values": {
      "items": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Values",
      "type": "array"
    }
  },
  "required": [
    "parameter_key",
    "backend",
    "unit",
    "times_s",
    "values",
    "validity",
    "reason",
    "analysis_config_hash",
    "source_ids"
  ],
  "title": "Track",
  "type": "object"
}
