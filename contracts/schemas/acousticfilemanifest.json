{
  "$defs": {
    "AcousticBackendObservation": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "enum": [
            "native_reaper",
            "reaper_python",
            "irapt1",
            "praat_fallback",
            "unavailable",
            "disabled"
          ],
          "title": "Actual",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "resource_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Sha256"
        },
        "stage": {
          "enum": [
            "reaper",
            "wm_f0"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "actual"
      ],
      "title": "AcousticBackendObservation",
      "type": "object"
    },
    "AcousticBackendPolicy": {
      "additionalProperties": false,
      "properties": {
        "reaper": {
          "default": "native_then_python",
          "enum": [
            "native_required",
            "native_then_python",
            "python_only",
            "disabled"
          ],
          "title": "Reaper",
          "type": "string"
        },
        "wm_f0": {
          "const": "irapt_then_praat",
          "default": "irapt_then_praat",
          "title": "Wm F0",
          "type": "string"
        }
      },
      "title": "AcousticBackendPolicy",
      "type": "object"
    },
    "AcousticConfigSnapshot": {
      "additionalProperties": false,
      "properties": {
        "backend_policy": {
          "$ref": "#/$defs/AcousticBackendPolicy"
        },
        "extended": {
          "anyOf": [
            {
              "$ref": "#/$defs/AcousticExtended"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "selection": {
          "$ref": "#/$defs/AcousticSelection"
        },
        "settings": {
          "$ref": "#/$defs/AcousticSettings"
        }
      },
      "title": "AcousticConfigSnapshot",
      "type": "object"
    },
    "AcousticDecodedAudio": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "maximum": 8,
          "minimum": 1,
          "title": "Channels",
          "type": "integer"
        },
        "sample_count": {
          "description": "Frames per channel, never the flattened channel sample count",
          "maximum": 2000000,
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "sample_dtype": {
          "enum": [
            "uint8",
            "int16",
            "int32",
            "float32",
            "float64"
          ],
          "title": "Sample Dtype",
          "type": "string"
        },
        "sample_rate_hz": {
          "exclusiveMinimum": 0,
          "maximum": 384000,
          "title": "Sample Rate Hz",
          "type": "integer"
        }
      },
      "required": [
        "sample_rate_hz",
        "channels",
        "sample_count",
        "sample_dtype"
      ],
      "title": "AcousticDecodedAudio",
      "type": "object"
    },
    "AcousticExtended": {
      "additionalProperties": false,
      "properties": {
        "audio_channel": {
          "anyOf": [
            {
              "maximum": 7,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio Channel"
        },
        "channel_overrides": {
          "additionalProperties": {
            "type": "integer"
          },
          "maxProperties": 1000,
          "title": "Channel Overrides",
          "type": "object"
        },
        "egg": {
          "anyOf": [
            {
              "$ref": "#/$defs/JointEggSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_duration_s": {
          "const": 1800,
          "default": 1800,
          "title": "Max Duration S",
          "type": "integer"
        },
        "revision": {
          "const": "bounded/1",
          "default": "bounded/1",
          "title": "Revision",
          "type": "string"
        }
      },
      "title": "AcousticExtended",
      "type": "object"
    },
    "AcousticInputSnapshot": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Asset Id",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "role": {
          "enum": [
            "audio",
            "textgrid",
            "lip"
          ],
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "sha256",
        "role",
        "expires_at"
      ],
      "title": "AcousticInputSnapshot",
      "type": "object"
    },
    "AcousticMetadata": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "const": "m01-adapter/1",
          "default": "m01-adapter/1",
          "title": "Adapter Version",
          "type": "string"
        },
        "algorithm_id": {
          "const": "m01.parameter_estimation",
          "default": "m01.parameter_estimation",
          "title": "Algorithm Id",
          "type": "string"
        },
        "algorithm_version": {
          "const": "legacy-numeric/1",
          "default": "legacy-numeric/1",
          "title": "Algorithm Version",
          "type": "string"
        },
        "backends": {
          "items": {
            "$ref": "#/$defs/AcousticBackendObservation"
          },
          "maxItems": 2,
          "title": "Backends",
          "type": "array"
        },
        "computation_revision": {
          "default": "acoustic/1",
          "enum": [
            "acoustic/1",
            "acoustic/2"
          ],
          "title": "Computation Revision",
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/AcousticConfigSnapshot"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "core_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Core Version",
          "type": "string"
        },
        "decoded": {
          "$ref": "#/$defs/AcousticDecodedAudio"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/AcousticInputSnapshot"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m01/1",
          "default": "m01/1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9_-]{0,79}$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "core_version",
        "project_id",
        "inputs",
        "decoded",
        "config",
        "config_sha256",
        "source_ids",
        "backends"
      ],
      "title": "AcousticMetadata",
      "type": "object"
    },
    "AcousticResultFile": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Asset Id",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "format": {
          "enum": [
            "xlsx",
            "sqlite"
          ],
          "title": "Format",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 5000000000,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "asset_id",
        "format",
        "size_bytes",
        "sha256",
        "expires_at"
      ],
      "title": "AcousticResultFile",
      "type": "object"
    },
    "AcousticSelection": {
      "additionalProperties": false,
      "properties": {
        "keys": {
          "items": {
            "enum": [
              "pF0",
              "rF0",
              "pF1",
              "pF2",
              "pF3",
              "pF4",
              "pB1",
              "pB2",
              "pB3",
              "pB4",
              "H1_pF0",
              "H1_rF0",
              "H2_pF0",
              "H2_rF0",
              "H4_pF0",
              "H4_rF0",
              "A1_pF0",
              "A1_rF0",
              "A2_pF0",
              "A2_rF0",
              "A3_pF0",
              "A3_rF0",
              "H1H2u_pF0",
              "H1H2u_rF0",
              "H2H4u_pF0",
              "H2H4u_rF0",
              "H1A1u_pF0",
              "H1A1u_rF0",
              "H1A2u_pF0",
              "H1A2u_rF0",
              "H1A3u_pF0",
              "H1A3u_rF0",
              "H1A1c_pF0",
              "H1A1c_rF0",
              "H1A2c_pF0",
              "H1A2c_rF0",
              "H1A3c_pF0",
              "H1A3c_rF0",
              "H1H2c_pF0",
              "H1H2c_rF0",
              "H2H4c_pF0",
              "H2H4c_rF0",
              "H2K_pF0",
              "H2K_rF0",
              "H5K_pF0",
              "H5K_rF0",
              "H42Ku_pF0",
              "H42Ku_rF0",
              "H2KH5Ku_pF0",
              "H2KH5Ku_rF0",
              "H42Kc_pF0",
              "H42Kc_rF0",
              "H2KH5Kc_pF0",
              "H2KH5Kc_rF0",
              "CPP_pF0",
              "CPP_rF0",
              "Intensity",
              "HNR05_pF0",
              "HNR15_pF0",
              "HNR25_pF0",
              "HNR35_pF0",
              "HNR05_rF0",
              "HNR15_rF0",
              "HNR25_rF0",
              "HNR35_rF0",
              "SHR_pF0",
              "SHR_rF0",
              "SpectralSlope_pF0",
              "SpectralSlope_rF0",
              "Jitter_Local",
              "Jitter_RAP",
              "Jitter_PPQ5",
              "Shimmer_Local",
              "Shimmer_APQ3",
              "Shimmer_APQ5",
              "Shimmer_APQ11",
              "LipArea",
              "LipWidth",
              "LipOpen",
              "LipCirc"
            ],
            "type": "string"
          },
          "maxItems": 80,
          "title": "Keys",
          "type": "array"
        },
        "mode": {
          "default": "catalog",
          "enum": [
            "catalog",
            "legacy_service"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "AcousticSelection",
      "type": "object"
    },
    "AcousticSettings": {
      "additionalProperties": false,
      "properties": {
        "energy_window_ms": {
          "default": 40.0,
          "maximum": 1000,
          "minimum": 1,
          "title": "Energy Window Ms",
          "type": "number"
        },
        "frameshift_ms": {
          "default": 5.0,
          "maximum": 1000,
          "minimum": 0.1,
          "title": "Frameshift Ms",
          "type": "number"
        },
        "lip_smooth_win_size": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Lip Smooth Win Size",
          "type": "integer"
        },
        "max_f0": {
          "default": 800.0,
          "maximum": 2000,
          "minimum": 50,
          "title": "Max F0",
          "type": "number"
        },
        "max_formant": {
          "default": 6000.0,
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Max Formant",
          "type": "number"
        },
        "min_f0": {
          "default": 30.0,
          "maximum": 1000,
          "minimum": 10,
          "title": "Min F0",
          "type": "number"
        },
        "n_periods": {
          "default": 3,
          "maximum": 100,
          "minimum": 1,
          "title": "N Periods",
          "type": "integer"
        },
        "num_formants": {
          "default": 5,
          "maximum": 10,
          "minimum": 3,
          "title": "Num Formants",
          "type": "integer"
        },
        "only_voiced": {
          "default": true,
          "title": "Only Voiced",
          "type": "boolean"
        },
        "reaper_hilbert": {
          "default": true,
          "title": "Reaper Hilbert",
          "type": "boolean"
        },
        "reaper_no_highpass": {
          "default": false,
          "title": "Reaper No Highpass",
          "type": "boolean"
        },
        "silence_threshold": {
          "default": 0.03,
          "maximum": 1,
          "minimum": 0,
          "title": "Silence Threshold",
          "type": "number"
        },
        "smooth_win_size": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "title": "Smooth Win Size",
          "type": "integer"
        },
        "windowsize_ms": {
          "default": 40.0,
          "maximum": 1000,
          "minimum": 1,
          "title": "Windowsize Ms",
          "type": "number"
        }
      },
      "title": "AcousticSettings",
      "type": "object"
    },
    "JointEggSettings": {
      "additionalProperties": false,
      "properties": {
        "auto_prominence": {
          "default": true,
          "title": "Auto Prominence",
          "type": "boolean"
        },
        "derived": {
          "default": false,
          "title": "Derived",
          "type": "boolean"
        },
        "egg_channel": {
          "default": 0,
          "maximum": 7,
          "minimum": 0,
          "title": "Egg Channel",
          "type": "integer"
        },
        "gci_method": {
          "default": "slope",
          "enum": [
            "slope",
            "scale"
          ],
          "title": "Gci Method",
          "type": "string"
        },
        "goi_method": {
          "default": "scale",
          "enum": [
            "slope",
            "scale"
          ],
          "title": "Goi Method",
          "type": "string"
        },
        "highpass_cutoff": {
          "default": 25.0,
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Highpass Cutoff",
          "type": "number"
        },
        "lowpass_cutoff": {
          "default": 2000.0,
          "exclusiveMinimum": 0,
          "maximum": 48000,
          "title": "Lowpass Cutoff",
          "type": "number"
        },
        "max_gap_ms": {
          "default": 50.0,
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "title": "Max Gap Ms",
          "type": "number"
        },
        "peak_prominence": {
          "default": 0.01,
          "maximum": 1,
          "minimum": 0,
          "title": "Peak Prominence",
          "type": "number"
        },
        "silence_threshold": {
          "default": 0.01,
          "maximum": 1,
          "minimum": 0,
          "title": "Silence Threshold",
          "type": "number"
        },
        "smooth_ms": {
          "default": 20.0,
          "maximum": 1000,
          "minimum": 0,
          "title": "Smooth Ms",
          "type": "number"
        },
        "storage": {
          "default": "aligned",
          "enum": [
            "aligned",
            "cycles"
          ],
          "title": "Storage",
          "type": "string"
        },
        "valley_prominence": {
          "default": 0.01,
          "maximum": 1,
          "minimum": 0,
          "title": "Valley Prominence",
          "type": "number"
        }
      },
      "title": "JointEggSettings",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "complete": {
      "const": true,
      "default": true,
      "title": "Complete",
      "type": "boolean"
    },
    "completed_at": {
      "minimum": 0,
      "title": "Completed At",
      "type": "number"
    },
    "expires_at": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expires At"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/AcousticResultFile"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Files",
      "type": "array"
    },
    "job_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Job Id",
      "type": "string"
    },
    "kind": {
      "const": "acoustic_file",
      "default": "acoustic_file",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/AcousticMetadata"
    },
    "policy_version": {
      "default": 1,
      "enum": [
        1,
        2
      ],
      "title": "Policy Version",
      "type": "integer"
    },
    "retention": {
      "enum": [
        "server",
        "local"
      ],
      "title": "Retention",
      "type": "string"
    },
    "row_count": {
      "exclusiveMinimum": 0,
      "maximum": 100000,
      "title": "Row Count",
      "type": "integer"
    },
    "schema_version": {
      "const": "m01/1",
      "default": "m01/1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "metadata",
    "completed_at",
    "retention",
    "expires_at",
    "row_count",
    "files"
  ],
  "title": "AcousticFileManifest",
  "type": "object"
}
