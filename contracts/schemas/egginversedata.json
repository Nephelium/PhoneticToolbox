{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audio_db": {
      "items": {
        "type": "number"
      },
      "maxItems": 30000,
      "title": "Audio Db",
      "type": "array"
    },
    "audio_values": {
      "items": {
        "type": "number"
      },
      "maxItems": 30000,
      "title": "Audio Values",
      "type": "array"
    },
    "egg_db": {
      "items": {
        "type": "number"
      },
      "maxItems": 30000,
      "title": "Egg Db",
      "type": "array"
    },
    "egg_values": {
      "items": {
        "type": "number"
      },
      "maxItems": 30000,
      "title": "Egg Values",
      "type": "array"
    },
    "fixed_window_crossings": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fixed Window Crossings"
    },
    "frequencies_hz": {
      "items": {
        "type": "number"
      },
      "maxItems": 30000,
      "title": "Frequencies Hz",
      "type": "array"
    },
    "full_egg_values": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "maxItems": 960000,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Full Egg Values"
    },
    "gci_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gci Count"
    },
    "inverse_db": {
      "items": {
        "type": "number"
      },
      "maxItems": 30000,
      "title": "Inverse Db",
      "type": "array"
    },
    "inverse_values": {
      "items": {
        "type": "number"
      },
      "maxItems": 30000,
      "title": "Inverse Values",
      "type": "array"
    },
    "lp_order": {
      "anyOf": [
        {
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lp Order"
    },
    "relative_times_s": {
      "items": {
        "type": "number"
      },
      "maxItems": 30000,
      "title": "Relative Times S",
      "type": "array"
    },
    "sample_rate_hz": {
      "anyOf": [
        {
          "maximum": 96000,
          "minimum": 8000,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sample Rate Hz"
    },
    "schema_version": {
      "const": "egg-inverse-view/1",
      "default": "egg-inverse-view/1",
      "title": "Schema Version",
      "type": "string"
    },
    "spectral_policy": {
      "const": "pad-44100-periodic-hamming-fft-80db-floor",
      "default": "pad-44100-periodic-hamming-fft-80db-floor",
      "title": "Spectral Policy",
      "type": "string"
    }
  },
  "required": [
    "frequencies_hz",
    "audio_db",
    "inverse_db",
    "egg_db",
    "relative_times_s",
    "audio_values",
    "inverse_values",
    "egg_values"
  ],
  "title": "EggInverseData",
  "type": "object"
}
