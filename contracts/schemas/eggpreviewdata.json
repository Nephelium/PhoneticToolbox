        "type": "array"
      },
      "maxItems": 1000,
      "title": "Movement",
      "type": "array"
    },
    "praat": {
      "$ref": "#/$defs/EggSeries"
    },
    "raster_shape": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "title": "Raster Shape",
      "type": "array"
    },
    "schema_version": {
      "const": "egg-preview/1",
      "default": "egg-preview/1",
