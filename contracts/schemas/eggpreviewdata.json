{
  "$defs": {
    "EggSeries": {
      "additionalProperties": false,
      "properties": {
        "times": {
          "items": {
            "type": "number"
          },
          "maxItems": 30000,
          "title": "Times",
          "type": "array"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxItems": 30000,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "times",
        "values"
      ],
      "title": "EggSeries",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audio": {
      "$ref": "#/$defs/EggSeries"
    },
    "cq": {
      "$ref": "#/$defs/EggSeries"
    },
    "display_policy": {
      "const": "legacy-roi-extent; grayscale-raster-only",
      "default": "legacy-roi-extent; grayscale-raster-only",
      "title": "Display Policy",
      "type": "string"
    },
    "egg": {
      "$ref": "#/$defs/EggSeries"
    },
    "gci": {
      "items": {
        "type": "number"
      },
      "maxItems": 10000,
      "title": "Gci",
      "type": "array"
    },
