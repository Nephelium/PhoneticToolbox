      "type": "array"
    },
    "spectral_shape": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "title": "Spectral Shape",
      "type": "array"
    },
    "sq": {
      "$ref": "#/$defs/EggSeries"
    }
