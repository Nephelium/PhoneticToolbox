      "$ref": "#/$defs/EggSeries"
    },
    "goi": {
      "items": {
        "type": "number"
      },
      "maxItems": 10000,
      "title": "Goi",
      "type": "array"
    },
    "micro_center": {
      "title": "Micro Center",
      "type": "number"
    },
    "micro_event_policy": {
      "const": "raw-50ms-padding",
      "default": "raw-50ms-padding",
      "title": "Micro Event Policy",
      "type": "string"
    },
    "micro_sample_stride": {
      "default": 1,
      "maximum": 64,
      "minimum": 1,
      "title": "Micro Sample Stride",
      "type": "integer"
    },
    "micro_wave_policy": {
      "const": "raw-100ms-padding-filter-crop",
