{
  "$defs": {
    "AcousticAssetRef": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Asset Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "sha256"
      ],
      "title": "AcousticAssetRef",
      "type": "object"
    },
    "AcousticBackendPolicy": {
      "additionalProperties": false,
      "properties": {
        "reaper": {
          "default": "native_then_python",
          "enum": [
            "native_required",
            "native_then_python",
            "python_only",
            "disabled"
          ],
          "title": "Reaper",
          "type": "string"
        },
        "wm_f0": {
          "const": "irapt_then_praat",
          "default": "irapt_then_praat",
          "title": "Wm F0",
          "type": "string"
        }
      },
      "title": "AcousticBackendPolicy",
      "type": "object"
    },
    "AcousticConfigSnapshot": {
      "additionalProperties": false,
      "properties": {
        "backend_policy": {
          "$ref": "#/$defs/AcousticBackendPolicy"
        },
        "selection": {
          "$ref": "#/$defs/AcousticSelection"
        },
        "settings": {
          "$ref": "#/$defs/AcousticSettings"
        }
      },
      "title": "AcousticConfigSnapshot",
      "type": "object"
    },
    "AcousticInputs": {
      "additionalProperties": false,
      "properties": {
        "audio": {
          "$ref": "#/$defs/AcousticAssetRef"
        },
        "lip": {
          "anyOf": [
            {
              "$ref": "#/$defs/AcousticAssetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "textgrid": {
          "anyOf": [
            {
              "$ref": "#/$defs/AcousticAssetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "audio"
      ],
      "title": "AcousticInputs",
      "type": "object"
    },
    "AcousticSelection": {
      "additionalProperties": false,
      "properties": {
        "keys": {
          "items": {
            "enum": [
              "pF0",
              "rF0",
              "pF1",
              "pF2",
              "pF3",
              "pF4",
              "pB1",
              "pB2",
              "pB3",
              "pB4",
              "H1_pF0",
              "H1_rF0",
              "H2_pF0",
              "H2_rF0",
              "H4_pF0",
              "H4_rF0",
              "A1_pF0",
              "A1_rF0",
              "A2_pF0",
              "A2_rF0",
              "A3_pF0",
              "A3_rF0",
              "H1H2u_pF0",
              "H1H2u_rF0",
              "H2H4u_pF0",
              "H2H4u_rF0",
              "H1A1u_pF0",
              "H1A1u_rF0",
              "H1A2u_pF0",
              "H1A2u_rF0",
              "H1A3u_pF0",
              "H1A3u_rF0",
              "H1A1c_pF0",
              "H1A1c_rF0",
              "H1A2c_pF0",
              "H1A2c_rF0",
              "H1A3c_pF0",
              "H1A3c_rF0",
              "H1H2c_pF0",
              "H1H2c_rF0",
              "H2H4c_pF0",
              "H2H4c_rF0",
              "H2K_pF0",
              "H2K_rF0",
              "H5K_pF0",
              "H5K_rF0",
              "H42Ku_pF0",
              "H42Ku_rF0",
              "H2KH5Ku_pF0",
              "H2KH5Ku_rF0",
              "H42Kc_pF0",
              "H42Kc_rF0",
              "H2KH5Kc_pF0",
              "H2KH5Kc_rF0",
              "CPP_pF0",
              "CPP_rF0",
              "Intensity",
              "HNR05_pF0",
              "HNR15_pF0",
              "HNR25_pF0",
              "HNR35_pF0",
              "HNR05_rF0",
              "HNR15_rF0",
              "HNR25_rF0",
              "HNR35_rF0",
              "SHR_pF0",
              "SHR_rF0",
              "SpectralSlope_pF0",
              "SpectralSlope_rF0",
              "Jitter_Local",
              "Jitter_RAP",
              "Jitter_PPQ5",
              "Shimmer_Local",
              "Shimmer_APQ3",
              "Shimmer_APQ5",
              "Shimmer_APQ11",
              "LipArea",
              "LipWidth",
              "LipOpen",
              "LipCirc"
            ],
            "type": "string"
          },
          "maxItems": 80,
          "title": "Keys",
          "type": "array"
        },
        "mode": {
          "default": "catalog",
          "enum": [
            "catalog",
            "legacy_service"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "AcousticSelection",
      "type": "object"
    },
    "AcousticSettings": {
      "additionalProperties": false,
      "properties": {
        "energy_window_ms": {
          "default": 40.0,
          "maximum": 1000,
          "minimum": 1,
          "title": "Energy Window Ms",
          "type": "number"
        },
        "frameshift_ms": {
          "default": 5.0,
          "maximum": 1000,
          "minimum": 0.1,
          "title": "Frameshift Ms",
          "type": "number"
        },
        "lip_smooth_win_size": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Lip Smooth Win Size",
          "type": "integer"
        },
        "max_f0": {
          "default": 880.0,
          "maximum": 2000,
          "minimum": 50,
          "title": "Max F0",
          "type": "number"
        },
        "max_formant": {
          "default": 6000.0,
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Max Formant",
          "type": "number"
        },
        "min_f0": {
          "default": 60.0,
          "maximum": 1000,
          "minimum": 10,
          "title": "Min F0",
          "type": "number"
        },
        "n_periods": {
          "default": 3,
          "maximum": 100,
          "minimum": 1,
          "title": "N Periods",
          "type": "integer"
        },
        "num_formants": {
          "default": 5,
          "maximum": 10,
          "minimum": 3,
          "title": "Num Formants",
          "type": "integer"
        },
        "only_voiced": {
          "default": true,
          "title": "Only Voiced",
          "type": "boolean"
        },
        "reaper_hilbert": {
          "default": true,
          "title": "Reaper Hilbert",
          "type": "boolean"
        },
        "reaper_no_highpass": {
          "default": false,
          "title": "Reaper No Highpass",
          "type": "boolean"
        },
        "silence_threshold": {
          "default": 0.03,
          "maximum": 1,
          "minimum": 0,
          "title": "Silence Threshold",
          "type": "number"
        },
        "smooth_win_size": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "title": "Smooth Win Size",
          "type": "integer"
        },
        "windowsize_ms": {
          "default": 40.0,
          "maximum": 1000,
          "minimum": 1,
          "title": "Windowsize Ms",
          "type": "number"
        }
      },
      "title": "AcousticSettings",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "config": {
      "$ref": "#/$defs/AcousticConfigSnapshot"
    },
    "idempotency_key": {
      "pattern": "^[A-Za-z0-9_-]{8,80}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "inputs": {
      "$ref": "#/$defs/AcousticInputs"
    },
    "operation": {
      "const": "acoustic_analysis",
      "default": "acoustic_analysis",
      "title": "Operation",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "m01/1",
      "default": "m01/1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "idempotency_key",
    "inputs"
  ],
  "title": "AcousticRequest",
  "type": "object"
}
