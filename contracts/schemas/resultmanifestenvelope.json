            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "format": {
          "enum": [
            "xlsx",
            "sqlite"
          ],
          "title": "Format",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 5000000000,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "asset_id",
        "format",
        "size_bytes",
        "sha256",
        "expires_at"
      ],
      "title": "AcousticResultFile",
      "type": "object"
    },
