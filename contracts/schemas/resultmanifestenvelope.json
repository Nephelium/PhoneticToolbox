{
  "$defs": {
    "AcousticBackendObservation": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "enum": [
            "native_reaper",
            "reaper_python",
            "irapt1",
            "praat_fallback",
            "unavailable",
            "disabled"
          ],
          "title": "Actual",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "resource_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Sha256"
        },
        "stage": {
          "enum": [
            "reaper",
            "wm_f0"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "actual"
      ],
      "title": "AcousticBackendObservation",
      "type": "object"
    },
    "AcousticBackendPolicy": {
      "additionalProperties": false,
      "properties": {
        "reaper": {
          "default": "native_then_python",
          "enum": [
            "native_required",
            "native_then_python",
            "python_only",
            "disabled"
          ],
          "title": "Reaper",
          "type": "string"
        },
        "wm_f0": {
          "const": "irapt_then_praat",
          "default": "irapt_then_praat",
          "title": "Wm F0",
          "type": "string"
        }
      },
      "title": "AcousticBackendPolicy",
      "type": "object"
    },
    "AcousticConfigSnapshot": {
      "additionalProperties": false,
      "properties": {
        "backend_policy": {
          "$ref": "#/$defs/AcousticBackendPolicy"
        },
        "selection": {
          "$ref": "#/$defs/AcousticSelection"
        },
        "settings": {
          "$ref": "#/$defs/AcousticSettings"
        }
      },
      "title": "AcousticConfigSnapshot",
      "type": "object"
    },
    "AcousticDecodedAudio": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "maximum": 8,
          "minimum": 1,
          "title": "Channels",
          "type": "integer"
        },
        "sample_count": {
          "description": "Frames per channel, never the flattened channel sample count",
          "maximum": 2000000,
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "sample_dtype": {
          "enum": [
            "uint8",
            "int16",
            "int32",
            "float32",
            "float64"
          ],
          "title": "Sample Dtype",
          "type": "string"
        },
        "sample_rate_hz": {
          "exclusiveMinimum": 0,
          "maximum": 384000,
          "title": "Sample Rate Hz",
          "type": "integer"
        }
      },
      "required": [
        "sample_rate_hz",
        "channels",
        "sample_count",
        "sample_dtype"
      ],
      "title": "AcousticDecodedAudio",
      "type": "object"
    },
    "AcousticFileManifest": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "const": true,
          "default": true,
          "title": "Complete",
          "type": "boolean"
        },
        "completed_at": {
          "minimum": 0,
          "title": "Completed At",
          "type": "number"
        },
        "expires_at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/AcousticResultFile"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Files",
          "type": "array"
        },
        "job_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Job Id",
          "type": "string"
        },
        "kind": {
          "const": "acoustic_file",
          "default": "acoustic_file",
          "title": "Kind",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/AcousticMetadata"
        },
        "retention": {
          "enum": [
            "server",
            "local"
          ],
          "title": "Retention",
          "type": "string"
        },
        "row_count": {
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Row Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "m01/1",
          "default": "m01/1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "metadata",
        "completed_at",
        "retention",
        "expires_at",
        "row_count",
        "files"
      ],
      "title": "AcousticFileManifest",
      "type": "object"
    },
    "AcousticInputSnapshot": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Asset Id",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "role": {
          "enum": [
            "audio",
            "textgrid",
            "lip"
          ],
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "sha256",
        "role",
        "expires_at"
      ],
      "title": "AcousticInputSnapshot",
      "type": "object"
    },
    "AcousticManagedFile": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "result",
          "default": "result",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 64000000,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "size_bytes",
        "sha256",
        "expires_at"
      ],
      "title": "AcousticManagedFile",
      "type": "object"
    },
    "AcousticMetadata": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "const": "m01-adapter/1",
          "default": "m01-adapter/1",
          "title": "Adapter Version",
          "type": "string"
        },
        "algorithm_id": {
          "const": "m01.parameter_estimation",
          "default": "m01.parameter_estimation",
          "title": "Algorithm Id",
          "type": "string"
        },
        "algorithm_version": {
          "const": "legacy-numeric/1",
          "default": "legacy-numeric/1",
          "title": "Algorithm Version",
          "type": "string"
        },
        "backends": {
          "items": {
            "$ref": "#/$defs/AcousticBackendObservation"
          },
          "maxItems": 2,
          "title": "Backends",
          "type": "array"
        },
        "config": {
          "$ref": "#/$defs/AcousticConfigSnapshot"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "core_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Core Version",
          "type": "string"
        },
        "decoded": {
          "$ref": "#/$defs/AcousticDecodedAudio"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/AcousticInputSnapshot"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "const": "m01/1",
          "default": "m01/1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9_-]{0,79}$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "core_version",
        "project_id",
        "inputs",
        "decoded",
        "config",
        "config_sha256",
        "source_ids",
        "backends"
      ],
      "title": "AcousticMetadata",
      "type": "object"
    },
    "AcousticResultFile": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
