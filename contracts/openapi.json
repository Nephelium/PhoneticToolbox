{
  "components": {
    "schemas": {
      "Audio": {
        "additionalProperties": false,
        "properties": {
          "channel_roles": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "title": "Channel Roles",
            "type": "array"
          },
          "channels": {
            "exclusiveMinimum": 0,
            "title": "Channels",
            "type": "integer"
          },
          "origin": {
            "enum": [
              "file",
              "recording",
              "generated"
            ],
            "title": "Origin",
            "type": "string"
          },
          "sample_count": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "title": "Sample Count",
            "type": "integer"
          },
          "sample_rate_hz": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "title": "Sample Rate Hz",
            "type": "integer"
          }
        },
        "required": [
          "sample_rate_hz",
          "channels",
          "channel_roles",
          "sample_count",
          "origin"
        ],
        "title": "Audio",
        "type": "object"
      },
      "Capabilities": {
        "additionalProperties": false,
        "properties": {
          "algorithms": {
            "items": {
              "type": "string"
            },
            "title": "Algorithms",
            "type": "array"
          },
          "api_version": {
            "default": "1.0.0",
            "title": "Api Version",
            "type": "string"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "stage": {
            "const": "P02",
            "default": "P02",
            "title": "Stage",
            "type": "string"
          }
        },
        "required": [
          "algorithms",
          "limitations"
        ],
        "title": "Capabilities",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "default": "1.0.0",
            "title": "Api Version",
            "type": "string"
          },
          "app_version": {
            "title": "App Version",
            "type": "string"
          },
          "core_version": {
            "title": "Core Version",
            "type": "string"
          },
          "mode": {
            "enum": [
              "local",
              "server"
            ],
            "title": "Mode",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "app_version",
          "core_version",
          "mode"
        ],
        "title": "Health",
        "type": "object"
      },
      "Selection": {
        "additionalProperties": false,
        "description": "Integer sample-frame interval [start_sample, end_sample).",
        "properties": {
          "end_sample": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "title": "End Sample",
            "type": "integer"
          },
          "sample_rate_hz": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "title": "Sample Rate Hz",
            "type": "integer"
          },
          "start_sample": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "title": "Start Sample",
            "type": "integer"
          }
        },
        "required": [
          "start_sample",
          "end_sample",
          "sample_rate_hz"
        ],
        "title": "Selection",
        "type": "object"
      },
      "Track": {
        "additionalProperties": false,
        "properties": {
          "analysis_config_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Analysis Config Hash",
            "type": "string"
          },
          "backend": {
            "minLength": 1,
            "title": "Backend",
            "type": "string"
          },
          "parameter_key": {
            "minLength": 1,
            "title": "Parameter Key",
            "type": "string"
          },
          "reason": {
            "items": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Reason",
            "type": "array"
          },
          "source_ids": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "title": "Source Ids",
            "type": "array"
          },
          "times_s": {
            "items": {
              "minimum": 0,
              "type": "number"
            },
            "title": "Times S",
            "type": "array"
          },
          "unit": {
            "description": "Explicit scientific unit, e.g. Hz, dB, s, %, or 1; parameter mapping is audited in P03.",
            "minLength": 1,
            "title": "Unit",
            "type": "string"
          },
          "validity": {
            "items": {
              "enum": [
                "valid",
                "unvoiced",
                "missing",
                "failed"
              ],
              "type": "string"
            },
            "title": "Validity",
            "type": "array"
          },
          "values": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Values",
            "type": "array"
          }
        },
        "required": [
          "parameter_key",
          "backend",
          "unit",
          "times_s",
          "values",
          "validity",
          "reason",
          "analysis_config_hash",
          "source_ids"
        ],
        "title": "Track",
        "type": "object"
      },
      "Viewport": {
        "additionalProperties": false,
        "properties": {
          "audio": {
            "$ref": "#/components/schemas/Audio"
          },
          "selection": {
            "$ref": "#/components/schemas/Selection"
          },
          "tracks": {
            "items": {
              "$ref": "#/components/schemas/Track"
            },
            "title": "Tracks",
            "type": "array"
          }
        },
        "required": [
          "audio",
          "selection",
          "tracks"
        ],
        "title": "Viewport",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "P02 read-only scaffold; no research processing or user storage.",
    "title": "PhoneticToolbox API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/capabilities": {
      "get": {
        "operationId": "get_capabilities",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Capabilities"
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
