{
  "components": {
    "schemas": {
      "Audio": {
        "additionalProperties": false,
        "properties": {
          "channel_roles": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "title": "Channel Roles",
            "type": "array"
          },
          "channels": {
            "exclusiveMinimum": 0,
            "title": "Channels",
            "type": "integer"
          },
          "origin": {
            "enum": [
              "file",
              "recording",
              "generated"
            ],
            "title": "Origin",
            "type": "string"
          },
          "sample_count": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "title": "Sample Count",
            "type": "integer"
          },
          "sample_rate_hz": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "title": "Sample Rate Hz",
            "type": "integer"
          }
        },
        "required": [
          "sample_rate_hz",
          "channels",
          "channel_roles",
          "sample_count",
          "origin"
        ],
        "title": "Audio",
        "type": "object"
      },
      "Capabilities": {
        "additionalProperties": false,
        "properties": {
          "algorithms": {
            "items": {
              "type": "string"
            },
            "title": "Algorithms",
            "type": "array"
          },
          "api_version": {
            "default": "1.0.0",
            "title": "Api Version",
            "type": "string"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "stage": {
            "default": "P02",
            "enum": [
              "P02",
              "P05",
              "P06"
            ],
            "title": "Stage",
            "type": "string"
          },
          "task_operations": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Task Operations",
            "type": "array"
          }
        },
        "required": [
          "algorithms",
          "limitations"
        ],
        "title": "Capabilities",
        "type": "object"
      },
      "Challenge": {
        "additionalProperties": false,
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          }
        },
        "required": [
          "csrf_token"
        ],
        "title": "Challenge",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "default": "1.0.0",
            "title": "Api Version",
            "type": "string"
          },
          "app_version": {
            "title": "App Version",
            "type": "string"
          },
          "core_version": {
            "title": "Core Version",
            "type": "string"
          },
          "mode": {
            "enum": [
              "local",
              "server"
            ],
            "title": "Mode",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "app_version",
          "core_version",
          "mode"
        ],
        "title": "Health",
        "type": "object"
      },
      "JobEvent": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "number"
          },
          "progress": {
            "title": "Progress",
            "type": "number"
          },
          "sequence": {
            "title": "Sequence",
            "type": "integer"
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "cancel_requested",
              "cancelled",
              "failed",
              "interrupted",
              "succeeded"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "sequence",
          "state",
          "progress",
          "code",
          "created_at"
        ],
        "title": "JobEvent",
        "type": "object"
      },
      "JobEvents": {
        "additionalProperties": false,
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/JobEvent"
            },
            "title": "Events",
            "type": "array"
          }
        },
        "required": [
          "events"
        ],
        "title": "JobEvents",
        "type": "object"
      },
      "JobInput": {
        "additionalProperties": false,
        "properties": {
          "config": {
            "$ref": "#/components/schemas/ProbeConfig"
          },
          "idempotency_key": {
            "pattern": "^[A-Za-z0-9_-]{8,80}$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "operation": {
            "const": "pipeline_check",
            "default": "pipeline_check",
            "title": "Operation",
            "type": "string"
          },
          "project_id": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "title": "Project Id",
            "type": "string"
          }
        },
        "required": [
          "project_id",
          "idempotency_key"
        ],
        "title": "JobInput",
        "type": "object"
      },
      "JobList": {
        "additionalProperties": false,
        "properties": {
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/JobView"
            },
            "title": "Jobs",
            "type": "array"
          }
        },
        "required": [
          "jobs"
        ],
        "title": "JobList",
        "type": "object"
      },
      "JobManifest": {
        "additionalProperties": false,
        "properties": {
          "complete": {
            "const": true,
            "default": true,
            "title": "Complete",
            "type": "boolean"
          },
          "core_version": {
            "title": "Core Version",
            "type": "string"
          },
          "kind": {
            "const": "pipeline_check_metadata",
            "default": "pipeline_check_metadata",
            "title": "Kind",
            "type": "string"
          },
          "sample_count": {
            "maximum": 4096.0,
            "minimum": 1.0,
            "title": "Sample Count",
            "type": "integer"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "sha256",
          "sample_count",
          "core_version"
        ],
        "title": "JobManifest",
        "type": "object"
      },
      "JobView": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "title": "Created At",
            "type": "number"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "generation": {
            "title": "Generation",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "operation": {
            "const": "pipeline_check",
            "default": "pipeline_check",
            "title": "Operation",
            "type": "string"
          },
          "progress": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Progress",
            "type": "number"
          },
          "project_id": {
            "title": "Project Id",
            "type": "string"
          },
          "result_manifest": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobManifest"
              },
              {
                "type": "null"
              }
            ]
          },
          "retry_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry Of"
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "cancel_requested",
              "cancelled",
              "failed",
              "interrupted",
              "succeeded"
            ],
            "title": "State",
            "type": "string"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "number"
          }
        },
        "required": [
          "id",
          "project_id",
          "state",
          "progress",
          "generation",
          "created_at",
          "updated_at",
          "result_manifest",
          "error_code"
        ],
        "title": "JobView",
        "type": "object"
      },
      "LoginInput": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,63}$",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginInput",
        "type": "object"
      },
      "ProbeConfig": {
        "additionalProperties": false,
        "properties": {
          "sample_count": {
            "default": 4096,
            "maximum": 4096.0,
            "minimum": 1.0,
            "title": "Sample Count",
            "type": "integer"
          },
          "seed": {
            "default": 0,
            "maximum": 255.0,
            "minimum": 0.0,
            "title": "Seed",
            "type": "integer"
          }
        },
        "title": "ProbeConfig",
        "type": "object"
      },
      "ProjectInput": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "ProjectInput",
        "type": "object"
      },
      "ProjectList": {
        "additionalProperties": false,
        "properties": {
          "projects": {
            "items": {
              "$ref": "#/components/schemas/ProjectView"
            },
            "title": "Projects",
            "type": "array"
          }
        },
        "required": [
          "projects"
        ],
        "title": "ProjectList",
        "type": "object"
      },
      "ProjectView": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "created_at"
        ],
        "title": "ProjectView",
        "type": "object"
      },
      "RetryInput": {
        "additionalProperties": false,
        "properties": {
          "idempotency_key": {
            "pattern": "^[A-Za-z0-9_-]{8,80}$",
            "title": "Idempotency Key",
            "type": "string"
          }
        },
        "required": [
          "idempotency_key"
        ],
        "title": "RetryInput",
        "type": "object"
      },
      "Selection": {
        "additionalProperties": false,
        "description": "Integer sample-frame interval [start_sample, end_sample).",
        "properties": {
          "end_sample": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "title": "End Sample",
            "type": "integer"
          },
          "sample_rate_hz": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "title": "Sample Rate Hz",
            "type": "integer"
          },
          "start_sample": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "title": "Start Sample",
            "type": "integer"
          }
        },
        "required": [
          "start_sample",
          "end_sample",
          "sample_rate_hz"
        ],
        "title": "Selection",
        "type": "object"
      },
      "SessionView": {
        "additionalProperties": false,
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserView"
          }
        },
        "required": [
          "user",
          "csrf_token",
          "expires_at"
        ],
        "title": "SessionView",
        "type": "object"
      },
      "Track": {
        "additionalProperties": false,
        "properties": {
          "analysis_config_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Analysis Config Hash",
            "type": "string"
          },
          "backend": {
            "minLength": 1,
            "title": "Backend",
            "type": "string"
          },
          "parameter_key": {
            "minLength": 1,
            "title": "Parameter Key",
            "type": "string"
          },
          "reason": {
            "items": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Reason",
            "type": "array"
          },
          "source_ids": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "title": "Source Ids",
            "type": "array"
          },
          "times_s": {
            "items": {
              "minimum": 0,
              "type": "number"
            },
            "title": "Times S",
            "type": "array"
          },
          "unit": {
            "description": "Explicit scientific unit, e.g. Hz, dB, s, %, or 1; parameter mapping is audited in P03.",
            "minLength": 1,
            "title": "Unit",
            "type": "string"
          },
          "validity": {
            "items": {
              "enum": [
                "valid",
                "unvoiced",
                "missing",
                "failed"
              ],
              "type": "string"
            },
            "title": "Validity",
            "type": "array"
          },
          "values": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Values",
            "type": "array"
          }
        },
        "required": [
          "parameter_key",
          "backend",
          "unit",
          "times_s",
          "values",
          "validity",
          "reason",
          "analysis_config_hash",
          "source_ids"
        ],
        "title": "Track",
        "type": "object"
      },
      "UserView": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username"
        ],
        "title": "UserView",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Viewport": {
        "additionalProperties": false,
        "properties": {
          "audio": {
            "$ref": "#/components/schemas/Audio"
          },
          "selection": {
            "$ref": "#/components/schemas/Selection"
          },
          "tracks": {
            "items": {
              "$ref": "#/components/schemas/Track"
            },
            "title": "Tracks",
            "type": "array"
          }
        },
        "required": [
          "audio",
          "selection",
          "tracks"
        ],
        "title": "Viewport",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Shared API; P05 accounts require configured PostgreSQL. Scientific tasks not yet connected.",
    "title": "PhoneticToolbox API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/challenge": {
      "get": {
        "operationId": "get_login_challenge",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Challenge"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Challenge",
        "tags": [
          "accounts"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login_account",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "accounts"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout_account",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "accounts"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "get_current_account",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionView"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Me",
        "tags": [
          "accounts"
        ]
      }
    },
    "/api/v1/capabilities": {
      "get": {
        "operationId": "get_capabilities",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Capabilities"
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/v1/jobs": {
      "get": {
        "operationId": "list_jobs",
        "parameters": [
          {
            "in": "query",
            "name": "project_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Project Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Listing",
        "tags": [
          "jobs"
        ]
      },
      "post": {
        "operationId": "create_job",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create",
        "tags": [
          "jobs"
        ]
      }
    },
    "/api/v1/jobs/{job_id}": {
      "get": {
        "operationId": "get_job",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get",
        "tags": [
          "jobs"
        ]
      }
    },
    "/api/v1/jobs/{job_id}/cancel": {
      "post": {
        "operationId": "cancel_job",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel",
        "tags": [
          "jobs"
        ]
      }
    },
    "/api/v1/jobs/{job_id}/events": {
      "get": {
        "operationId": "get_job_events",
        "parameters": [
          {
            "in": "path",
