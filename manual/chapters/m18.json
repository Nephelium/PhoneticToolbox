        "type": "image",
        "attrs": {
          "id": "m18-r2-reader-details-20261008-figure",
          "assetId": "m18-r3-reader-details-a74761e2",
          "caption": "展开论文信息，查看双语题名、作者、固定版本、许可、翻译说明和阅读导引。",
          "alt": "展开论文信息，查看双语题名、作者、固定版本、许可、翻译说明和阅读导引。",
