# Include only in the existing HTTPS site's server{} after checking its config.
# Site access-log format must omit IP, query, authorization, email and bodies.
location ^~ /api/v1/feedback/ {
    client_max_body_size 14m;
    proxy_pass http://127.0.0.1:18766;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 45s;
    access_log off;
    error_log /dev/null crit;
}
