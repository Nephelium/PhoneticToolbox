# Include only inside the existing www.phonetictoolbox.com HTTPS server block.
# Preserve the existing ^~ /api/v1/feedback/ location (port 18766), downloads,
# papers and homepage. No DNS or certificate replacement is needed.
location = /app { return 308 /app/; }
location ^~ /app/ {
    proxy_pass http://127.0.0.1:18775;
    include /etc/nginx/snippets/ptb-web-proxy.conf;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-GqsWfEjHm73zbHa7lGbVXfv95jxypKuCtjd6kntjIRA='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Content-Type-Options nosniff always;
    access_log off;
    error_log /dev/null crit;
}
# Never expose the service-to-service administration channel publicly.
location ^~ /api/v1/_ops/ { return 404; }
location ^~ /api/v1/feedback/internal/ { return 404; }
location /api/v1/ {
    client_max_body_size 100m;
    client_body_timeout 30s;
    proxy_pass http://127.0.0.1:18775;
    include /etc/nginx/snippets/ptb-web-proxy.conf;
    add_header Cache-Control no-store always;
    add_header X-Content-Type-Options nosniff always;
    access_log /var/log/nginx/ptb-website-stats.log ptb_website_stats if=$ptb_stats_loggable;
    error_log /dev/null crit;
}
